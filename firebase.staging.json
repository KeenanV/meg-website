{
  "hosting": {
    "site": "megvandeusen-staging",
    "public": ".firebase/staging-empty",
    "ignore": ["**/*"],
    "rewrites": [{"source": "**", "run": {"serviceId": "staging-website", "region": "us-west1", "pinTag": true}}],
    "headers": [{"source": "**", "headers": [
      {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"},
      {"key": "Cache-Control", "value": "private, no-store"}
    ]}]
  }
}
