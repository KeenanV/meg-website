---
import Layout from '../layouts/Layout.astro';
import StaticGlassCard from '../components/StaticGlassCard.astro';
import GlassButton from '../components/GlassButton.astro';
const endpoint = import.meta.env.PUBLIC_CONTACT_API_URL || '';
const siteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || '';
const enabled = Boolean(endpoint && siteKey);
---
<Layout title="Contact" description="Contact Meg Van Deusen for questions, scheduling, availability, or to share your thoughts.">
  <StaticGlassCard class="p-7 md:p-10">
    <header>
      <h1 id="contact-title" class="page-heading">Contact</h1>
      <p class="mt-4 text-base leading-relaxed text-white/80">
        Contact Meg for questions, scheduling, availability, or just to share your thoughts.
      </p>
      <p class="mt-3">
        <a href="tel:+12063293797" class="inline-flex items-center gap-2 rounded-md py-1 text-lg text-white/90 underline decoration-white/40 underline-offset-4 transition hover:text-white hover:decoration-white">
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 11.19 18a19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.91-8.67A2 2 0 0 1 3.26 1.15h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.71 2.79a2 2 0 0 1-.45 2.11L7.25 9.04a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.35 1.83.59 2.79.71A2 2 0 0 1 22 16.92Z" />
          </svg>
          <span>(206) 329-3797</span>
        </a>
      </p>
    </header>

    <form id="contact-form" method="post" data-endpoint={endpoint} data-site-key={siteKey} aria-labelledby="contact-title" aria-describedby="contact-status" class="mt-8 space-y-6">
      <div class="contact-trap" aria-hidden="true" inert>
        <label for="contact-website">Leave this field empty</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div>
        <label for="contact-name" class="mb-2 block text-sm font-medium text-white/90">Name</label>
        <div class="contact-field" data-liquid="true">
          <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="120"
            class="contact-input" />
        </div>
      </div>
      <div>
        <label for="contact-email" class="mb-2 block text-sm font-medium text-white/90">Email</label>
        <div class="contact-field" data-liquid="true">
          <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254"
            autocapitalize="none" spellcheck="false" class="contact-input" />
        </div>
      </div>
      <div>
        <label for="contact-message" class="mb-2 block text-sm font-medium text-white/90">Message</label>
        <div class="contact-field" data-liquid="true">
          <textarea id="contact-message" name="message" required maxlength="5000" rows="6"
            class="contact-input min-h-40 resize-y"></textarea>
        </div>
      </div>
      <div class="flex flex-col items-start gap-3 border-t border-white/15 pt-6">
        <GlassButton type="submit" disabled={true} class="disabled:cursor-wait disabled:opacity-60">Send message</GlassButton>
        <p id="contact-status" role="status" aria-live="polite" class="text-sm text-white/70">{enabled ? 'Loading contact form…' : 'Messaging will be available soon.'}</p>
        {enabled && <p class="text-xs leading-relaxed text-white/60">
          This form is protected by reCAPTCHA. Google’s <a href="https://policies.google.com/privacy" class="underline">Privacy Policy</a> and <a href="https://policies.google.com/terms" class="underline">Terms of Service</a> apply.
        </p>}
        <noscript><p class="text-sm text-white/70">Please enable JavaScript to send a message.</p></noscript>
      </div>
    </form>
  </StaticGlassCard>
</Layout>

<script>
  import '../scripts/contact-form';
</script>

<style>
  .contact-trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .contact-field { position: relative; border-radius: 1rem; }
  .contact-field::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(300px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, 0.12), transparent 60%);
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .contact-field[data-liquid-active="true"]::after { opacity: 1; }
  .contact-input {
    display: block;
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.055);
    padding: 0.85rem 1rem;
    color: white;
    font: inherit;
    font-size: 1rem;
    line-height: 1.6;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: border-color 200ms ease, background-color 200ms ease, box-shadow 200ms ease;
  }
  .contact-field[data-liquid-active="true"] .contact-input:not(:focus) { border-color: rgba(255, 255, 255, 0.35); }
  .contact-input:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.09);
    box-shadow: inset 0 0 6px rgba(255, 255, 255, 0.12),
      0 0 6px rgba(255, 255, 255, 0.35),
      0 0 20px rgba(255, 255, 255, 0.22),
      0 0 36px rgba(255, 255, 255, 0.1);
  }
  @media (forced-colors: active) {
    .contact-input:focus { outline: 2px solid Highlight; outline-offset: 2px; }
  }
</style>
