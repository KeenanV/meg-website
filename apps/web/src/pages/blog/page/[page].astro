---
import ArticlePage from '../../../layouts/ArticlePage.astro';
import { sanity } from '../../../lib/sanity';
import { qPosts } from '../../../lib/queries';
import { hasValidSlug, type Article } from '../../../lib/content';
import { paginate } from '../../../lib/pagination';
export async function getStaticPaths() {
  const items = (await sanity.fetch<Article[]>(qPosts)).filter(hasValidSlug);
  const { totalPages } = paginate(items);
  return Array.from({ length: totalPages - 1 }, (_, index) => ({
    params: { page: String(index + 2) }, props: { page: index + 2, items },
  }));
}
interface Props { page: number; items: Article[] }
const requestedPage = Astro.props.page ?? Number(Astro.params.page);
if (!Number.isSafeInteger(requestedPage) || requestedPage < 1) return new Response('Not found.', {status: 404});
---
<ArticlePage kind="blog" page={requestedPage} items={Astro.props.items} />
