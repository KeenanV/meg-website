---
import Layout from "../../layouts/Layout.astro";
import { sanity, urlFor } from "../../lib/sanity";
import { qPosts, qPostBySlug } from "../../lib/queries";
import GlassCard from "../../components/GlassCard.astro";
import {portableTextToHtml} from "../../lib/portableText";

export async function getStaticPaths() {
  const items = await sanity.fetch(qPosts);
  return items.map((item: any) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const blogPost = await sanity.fetch(qPostBySlug, { slug });
const bodyHtml = portableTextToHtml(blogPost.body);

if (!blogPost) {
  throw new Error("Not found");
}
---

<Layout title={blogPost.title} bgImage="/bg-blog.jpg">
  <GlassCard hover={false} class="p-0 overflow-hidden">
    <div class="p-8 md:p-10">
      <h1 class="text-4xl font-semibold tracking-tight">{blogPost.title}</h1>
      <div class="mt-3 text-sm text-white/55">{blogPost.excerpt}</div>
    </div>

    {blogPost.cover && (
        <img
            src={urlFor(blogPost.cover).width(900).quality(100).url()}
            alt={blogPost.name ?? "Cover Image"}
            class="h-65 w-full object-cover rounded-2xl"
            loading="lazy"
        />
    )}

    <div class="p-8 md:p-10">
      <div class="mt-8 prose prose-invert max-w-none prose-a:text-emerald-200">
        <div set:html={bodyHtml}/>
      </div>
    </div>
  </GlassCard>
</Layout>