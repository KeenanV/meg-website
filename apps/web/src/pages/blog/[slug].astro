---
import Layout from '../../layouts/Layout.astro';
import ArticleContent from '../../components/ArticleContent.astro';
import { sanity } from '../../lib/sanity';
import { qPostPages } from '../../lib/queries';
import { articlePaths, type Article } from '../../lib/content';
export async function getStaticPaths() {
  return articlePaths(await sanity.fetch<Article[]>(qPostPages));
}
interface Props { entry: Article }
const { entry } = Astro.props;
---
<Layout title={entry.title} description={entry.excerpt || 'An article by Meg Van Deusen from Sight On Stress.'} backgroundScene="city">
  <ArticleContent entry={entry} kind="blog" />
</Layout>
