---
import ArticlePage from '../../layouts/ArticlePage.astro';
import { sanity } from '../../lib/sanity';
import { qPostPages } from '../../lib/queries';
import { articlePaths, type Article } from '../../lib/content';
export async function getStaticPaths() {
  return articlePaths(await sanity.fetch<Article[]>(qPostPages));
}
interface Props { entry: Article }
const { entry } = Astro.props;
---
<ArticlePage entry={entry} kind="blog" />
