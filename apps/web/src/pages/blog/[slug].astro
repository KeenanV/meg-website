---
import Layout from "../../layouts/Layout.astro";
import { sanity, urlFor } from "../../lib/sanity";
import { qPosts, qPostBySlug } from "../../lib/queries";

export async function getStaticPaths() {
  const items = await sanity.fetch(qPosts);
  return items.map((item: any) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const blogPost = await sanity.fetch(qPostBySlug, { slug });

if (!blogPost) {
  throw new Error("Not found");
}
---

<Layout title={blogPost.title} bgImage="/bg-blog.jpg">
  <article>
    <h1>{blogPost.title}</h1>
    {blogPost.date && <small>{new Date(blogPost.date).toLocaleDateString()}</small>}
    {blogPost?.cover && (
        <img
            src={urlFor(blogPost.cover).width(150).quality(100).url()}
            alt={blogPost.name ?? "Cover Image"}
            loading="lazy"
        />
    )}
    {blogPost.body?.map((block: any) => (
        <p>{block.children?.map((c: any) => c.text).join("")}</p>
    ))}
  </article>
</Layout>