---
import Layout from "../layouts/Layout.astro";
import GlassCard from "../components/GlassCard.astro";
import SectionHeader from "../components/SectionHeader.astro";

import { sanity, urlFor } from "../lib/sanity";
import { qPosts } from "../lib/queries";

const posts = await sanity.fetch(qPosts);
---

<Layout title="Sight On Stress" bgImage="/bg-blog.jpg" contentWidth="6xl">
  <SectionHeader
      title="Sight On Stress"
      subtitle="Writing and reflections."
  />

  <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {posts?.map((p: any) => (
        <GlassCard href={`/blog/${p.slug}`} class="p-0 overflow-hidden hover:shadow-blue-500/10">
          {p.cover && (
              <img
                  src={urlFor(p.cover).width(900).height(520).fit("crop").quality(85).url()}
                  alt={p.title ?? "Blog cover"}
                  class="h-44 w-full object-cover rounded-2xl"
                  loading="lazy"
              />
          )}

          <div class="p-6">
            <div class="text-lg font-semibold leading-snug">{p.title}</div>

            {p.publishedAt && (
                <div class="mt-2 text-xs text-white/50">
                  {new Date(p.publishedAt).toLocaleDateString()}
                </div>
            )}

            {p.excerpt && (
                <p class="mt-3 text-sm leading-relaxed text-white/65 line-clamp-3">
                  {p.excerpt}
                </p>
            )}
          </div>
        </GlassCard>
    ))}
  </div>
</Layout>