---
import Layout from '../layouts/Layout.astro';
import GlassCard from '../components/GlassCard.astro';
import ArticleViewer from '../components/ArticleViewer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SanityImage from '../components/SanityImage.astro';
import { sanity } from '../lib/sanity';
import { qPosts } from '../lib/queries';
import { hasValidSlug, type Article } from '../lib/content';
import { formatDate } from '../lib/dates';
const posts = (await sanity.fetch<Article[]>(qPosts)).filter(hasValidSlug);
---
<Layout title="Sight On Stress" backgroundScene="city" contentWidth="6xl" description="Writing and reflections on stress, sleep, and well-being by Meg Van Deusen.">
  <div class="section-intro"><SectionHeader level="h1" title="Sight On Stress" subtitle="Writing and reflections." /></div>
  <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {posts.map((post, index) => (
      <GlassCard href={'/blog/' + post.slug} padding={false} article>
        {post.cover && <SanityImage image={post.cover} alt="" width={840} height={525}
          sizes="(min-width: 1280px) 360px, (min-width: 768px) 45vw, 100vw" priority={index < 3}
          class="aspect-[8/5] w-full shrink-0 object-cover" />}
        <div class="flex flex-1 flex-col p-6">
          {formatDate(post.publishedAt) && <time datetime={post.publishedAt} class="text-xs text-emerald-100">{formatDate(post.publishedAt)}</time>}
          <h2 class="mt-2 text-xl font-semibold leading-snug tracking-tight">{post.title}</h2>
          {post.excerpt && <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-white/80">{post.excerpt}</p>}
          <p class="mt-auto pt-5 text-sm text-emerald-100">Read article <span aria-hidden="true">→</span></p>
        </div>
      </GlassCard>
    ))}
  </div>
  {!posts.length && <p class="glass-surface mt-6 p-8 text-white/80">There are no articles to share just yet. Please check back soon.</p>}
  <ArticleViewer />
</Layout>
