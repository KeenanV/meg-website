---
import Layout from '../layouts/Layout.astro';
import StaticGlassCard from '../components/StaticGlassCard.astro';
import GlassButton from '../components/GlassButton.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SanityImage from '../components/SanityImage.astro';
import { sanity, richTextImageUrl } from '../lib/sanity';
import { portableTextToHtml } from '../lib/portableText';
import { qBooks } from '../lib/queries';
import { safeHref } from '../lib/urls';
import type { Book } from '../lib/content';
const books = await sanity.fetch<Book[]>(qBooks);
---
<Layout title="Books" contentWidth="4xl" description="Explore books by clinical psychologist Meg Van Deusen, with descriptions and links to purchase.">
  <div class="section-intro">
    <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-emerald-100">The bookshelf</p>
    <SectionHeader level="h1" title="Books" subtitle="Psychology beyond therapy sessions." />
  </div>
  <div class="mt-6 space-y-6">
    {books.map((book, index) => {
      const links = (book.buyLinks ?? []).map(link => ({ ...link, href: safeHref(link.url) })).filter(link => link.href);
      const descriptionHtml = portableTextToHtml(book.descriptionRichText, richTextImageUrl);
      const endorsementsHtml = portableTextToHtml(book.endorsements, richTextImageUrl);
      return (
        <StaticGlassCard class="p-7 md:p-10">
          <article class="grid items-start gap-8 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-10">
            {book.cover && <div class="mx-auto w-48 lg:w-full">
              <SanityImage image={book.cover} alt={book.cover.alt || 'Cover of ' + book.title} width={660}
                sizes="(min-width: 1024px) 220px, 192px" priority={index === 0}
                class="h-auto w-full rounded-lg border border-white/20 shadow-2xl" />
            </div>}
            <div class:list={[!book.cover && 'lg:col-span-2']}>
              <p class="text-sm text-emerald-100">{book.year == null ? 'Coming Soon' : `Published ${book.year}`}</p>
              <h2 class="mt-3 text-2xl font-semibold leading-snug tracking-tight md:text-3xl">{book.title}</h2>
              {Array.isArray(book.descriptionRichText)
                ? <div class="reading-copy mt-5" set:html={descriptionHtml} />
                : book.description && <p class="mt-5 whitespace-pre-line text-base leading-relaxed text-white/90">{book.description}</p>}
              {endorsementsHtml && <details class="mt-6 rounded-2xl border border-white/15 bg-white/5" data-animated-disclosure>
                <summary class="relative flex cursor-pointer items-center justify-between gap-3 overflow-hidden rounded-2xl px-5 py-4 text-lg font-medium transition data-[liquid-active=true]:bg-white/10" data-liquid="true">
                  <span aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-0 transition-opacity liquid-highlight"
                    style="background: radial-gradient(300px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.12), transparent 60%);"></span>
                  <span class="relative">Read endorsements<span class="sr-only"> for {book.title}</span></span>
                  <svg class="relative disclosure-chevron h-5 w-5 shrink-0 transition-transform duration-300 ease-in-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </summary>
                <div class="book-endorsements reading-copy px-5 pb-5" set:html={endorsementsHtml} />
              </details>}
              {links.length > 0 && <div class="mt-7 flex flex-wrap gap-3">
                {links.map(link => <GlassButton href={link.href} target="_blank">
                  {link.label || 'Buy the book'}<span aria-hidden="true" class="ml-3">↗</span><span class="sr-only"> (opens in a new tab)</span>
                </GlassButton>)}
              </div>}
            </div>
          </article>
        </StaticGlassCard>
      );
    })}
    {!books.length && <StaticGlassCard class="p-8"><p class="text-white/80">Book details will be available soon.</p></StaticGlassCard>}
  </div>
</Layout>

<style>
  /* Endorsement text includes its own quotation marks. */
  .book-endorsements :global(blockquote) { quotes: none; }
</style>

<script>
  import '../scripts/animated-disclosures';
</script>
