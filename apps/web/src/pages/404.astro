---
import Layout from '../layouts/Layout.astro';
import StaticGlassCard from '../components/StaticGlassCard.astro';
---
<Layout title="Page not found" noindex>
  <StaticGlassCard class="p-8 md:p-10">
    <p class="text-sm text-emerald-100">404</p>
    <h1 class="page-heading mt-3">A little off the path.</h1>
    <p class="mt-5 text-white/80">This page could not be found. It may have moved, or the link may be incomplete.</p>
    <a href="/" class="mt-7 inline-block rounded-2xl border border-white/20 bg-white/10 px-5 py-3 hover:bg-white/20">Return home</a>
  </StaticGlassCard>
</Layout>
