---
import Layout from '../../layouts/Layout.astro';
import ArticleContent from '../../components/ArticleContent.astro';
import { sanity } from '../../lib/sanity';
import { qNewsPages } from '../../lib/queries';
import { articlePaths, type Article } from '../../lib/content';
export async function getStaticPaths() {
  return articlePaths(await sanity.fetch<Article[]>(qNewsPages));
}
interface Props { entry: Article }
const { entry } = Astro.props;
---
<Layout title={entry.title} description={entry.title + ' — news from Meg Van Deusen.'} backgroundScene="shore">
  <ArticleContent entry={entry} kind="news" />
</Layout>
