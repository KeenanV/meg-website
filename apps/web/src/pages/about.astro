---
import Layout from '../layouts/Layout.astro';
import StaticGlassCard from '../components/StaticGlassCard.astro';
import GlassButton from '../components/GlassButton.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { sanity, urlFor, richTextImageUrl } from '../lib/sanity';
import { qAbout, qSocialLinks } from '../lib/queries';
import type { About, ProfileLink } from '../lib/content';
import { portableTextToHtml } from '../lib/portableText';

const [about, socials] = await Promise.all([
  sanity.fetch<About | null>(qAbout),
  sanity.fetch<ProfileLink[] | null>(qSocialLinks),
]);
const sections = [
  { id: 'about', title: 'About', body: about?.about },
  { id: 'approach', title: 'Approach', body: about?.approach },
  { id: 'fees', title: 'Fees & Insurance', body: about?.feesInsurance },
].map(section => ({ ...section, html: portableTextToHtml(section.body, richTextImageUrl) })).filter(section => section.html);
const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent('2366 Eastlake Avenue E, Suite 407, Seattle, WA 98102');
// Generated by Google Maps' Share > Embed a map for the office building.
const mapEmbedUrl = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2688.1971596796097!2d-122.32564119999998!3d47.6417354!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x549014e1bbc2970f%3A0xe6c8baa17a9fefe7!2s2366%20Eastlake%20Ave%20E%2C%20Seattle%2C%20WA%2098102!5e0!3m2!1sen!2sus!4v1790465213746!5m2!1sen!2sus';
---
<Layout title="About" description="Learn about Meg Van Deusen's background, approach to psychotherapy, fees and insurance, and Seattle office location.">
  <StaticGlassCard>
    <div class="flex flex-col gap-7 p-7 md:flex-row md:items-center md:p-10">
      {about?.headshot && <img src={urlFor(about.headshot).width(384).height(576).fit('crop').quality(85).url()}
        alt={about.headshot.alt || about.name || 'Meg Van Deusen'} width="384" height="576"
        class="mx-auto h-72 w-48 shrink-0 rounded-2xl border border-white/15 object-cover md:mx-0" decoding="async" />}
      <div class="about-identity min-w-0 text-center md:text-left">
        <h1 class="page-heading about-name">{about?.name || 'Meg Van Deusen'}</h1>
        <p class="mt-2 text-white/80 md:mt-4">Clinical Psychologist · Author</p>
        <SocialLinks links={socials ?? []} class="mt-3 justify-center md:mt-4 md:justify-start" />
        <GlassButton href="/contact" class="mt-3 md:mt-5">Contact</GlassButton>
      </div>
    </div>
    {[...sections, { id: 'location', title: 'Location', html: '' }].map(section => (
      <details class="border-t border-white/15" id={section.id} data-animated-disclosure>
        <summary class="group relative overflow-hidden cursor-pointer px-7 py-6 text-center transition data-[liquid-active=true]:bg-white/10 md:px-10" data-liquid="true">
          <span aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-0 transition-opacity liquid-highlight"
            style="background: radial-gradient(300px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.12), transparent 60%);"></span>
          <h2 class="relative text-2xl font-semibold">{section.title}</h2>
          <svg class="relative disclosure-chevron mx-auto mt-3 h-5 w-5 text-white/80 transition-transform duration-300 ease-in-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        {section.id === 'location' ? (
          <div class="reading-copy px-7 pb-8 md:px-10">
            <div class="not-prose">
              <div class="mb-6 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:justify-between">
                <address class="text-base not-italic leading-relaxed text-white/90">
                  2366 Eastlake Avenue E.<br />
                  Suite 407<br />
                  Seattle, WA 98102
                </address>
                <GlassButton href={directionsUrl} target="_blank" contentClass="flex items-center gap-2">
                  <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m12 3 9 9-9 9-9-9 9-9Z M8 15v-4h7m-3-3 3 3-3 3" />
                  </svg>
                  Get directions
                </GlassButton>
              </div>
              <iframe src={mapEmbedUrl} title="Google Maps: Meg Van Deusen's office at 2366 Eastlake Avenue E, Seattle"
                class="block h-80 w-full rounded-2xl border border-white/15 sm:h-96"
                width="600" height="450" loading="lazy" allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>
          </div>
        ) : <div class="reading-copy px-7 pb-8 md:px-10" set:html={section.html} />}
      </details>
    ))}
    {!sections.length && <p class="px-7 pb-8 text-white/80 md:px-10">More about Meg will be available soon.</p>}
  </StaticGlassCard>
</Layout>

<style>
  @media (max-width: 767px) {
    .about-identity { container-type: inline-size; }
    .about-name { font-size: clamp(1.375rem, 10.5cqi, 2.25rem); white-space: nowrap; }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLDetailsElement>('[data-animated-disclosure]').forEach(details => {
    const summary = details.querySelector('summary');
    const panel = details.querySelector<HTMLElement>('.reading-copy');
    if (!summary || !panel || !details.animate) return;

    let expanded = details.open;
    let animation: Animation | undefined;
    const finish = () => {
      details.open = expanded;
      animation?.cancel();
      animation = undefined;
      details.style.removeProperty('overflow');
    };

    summary.addEventListener('click', event => {
      event.preventDefault();
      // Capture the current frame before cancelling, so rapid clicks reverse smoothly.
      const startHeight = details.getBoundingClientRect().height;
      animation?.cancel();
      expanded = !expanded;
      summary.setAttribute('aria-expanded', String(expanded));
      details.dataset.expanded = String(expanded);
      panel.inert = !expanded;
      if (reducedMotion.matches) {
        finish();
        return;
      }

      // Measure both native states, then keep the content rendered until closing finishes.
      details.open = expanded;
      const endHeight = details.getBoundingClientRect().height;
      details.open = true;
      details.style.overflow = 'hidden';
      animation = details.animate(
        { height: [`${startHeight}px`, `${endHeight}px`] },
        { duration: 300, easing: 'ease-in-out', fill: 'both' },
      );
      animation.onfinish = finish;
    });
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches && animation) finish();
    });
  });
</script>
