---
import Layout from '../layouts/Layout.astro';
import StaticGlassCard from '../components/StaticGlassCard.astro';
import { sanity, urlFor, richTextImageUrl } from '../lib/sanity';
import { qAbout } from '../lib/queries';
import type { About } from '../lib/content';
import { portableTextToHtml } from '../lib/portableText';

const about = await sanity.fetch<About | null>(qAbout);
const sections = [
  { id: 'about', title: 'About', body: about?.about },
  { id: 'approach', title: 'Approach', body: about?.approach },
  { id: 'fees', title: 'Fees & Insurance', body: about?.feesInsurance },
].map(section => ({ ...section, html: portableTextToHtml(section.body, richTextImageUrl) })).filter(section => section.html);
---
<Layout title="About" description="Learn about Meg Van Deusen's background, approach to psychotherapy, and fees and insurance.">
  <StaticGlassCard>
    <div class="flex flex-col gap-7 p-7 md:flex-row md:items-center md:p-10">
      {about?.headshot && <img src={urlFor(about.headshot).width(384).height(576).fit('crop').quality(85).url()}
        alt={about.headshot.alt || about.name || 'Meg Van Deusen'} width="384" height="576"
        class="h-72 w-48 rounded-2xl border border-white/15 object-cover" decoding="async" />}
      <div>
        <h1 class="page-heading">{about?.name || 'Meg Van Deusen'}</h1>
        <p class="mt-4 text-white/80">Clinical Psychologist · Author</p>
      </div>
    </div>
    {sections.map(section => (
      <details class="border-t border-white/15" id={section.id} data-animated-disclosure>
        <summary class="group cursor-pointer px-7 py-6 text-center transition hover:bg-white/10 md:px-10" data-liquid="true">
          <h2 class="text-2xl font-semibold">{section.title}</h2>
          <svg class="disclosure-chevron mx-auto mt-3 h-5 w-5 text-white/80 transition-transform duration-300 ease-in-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="reading-copy px-7 pb-8 md:px-10" set:html={section.html} />
      </details>
    ))}
    {!sections.length && <p class="px-7 pb-8 text-white/80 md:px-10">More about Meg will be available soon.</p>}
  </StaticGlassCard>
</Layout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLDetailsElement>('[data-animated-disclosure]').forEach(details => {
    const summary = details.querySelector('summary');
    const panel = details.querySelector<HTMLElement>('.reading-copy');
    if (!summary || !panel || !details.animate) return;

    let expanded = details.open;
    let animation: Animation | undefined;
    const finish = () => {
      details.open = expanded;
      animation?.cancel();
      animation = undefined;
      details.style.removeProperty('overflow');
    };

    summary.addEventListener('click', event => {
      event.preventDefault();
      // Capture the current frame before cancelling, so rapid clicks reverse smoothly.
      const startHeight = details.getBoundingClientRect().height;
      animation?.cancel();
      expanded = !expanded;
      summary.setAttribute('aria-expanded', String(expanded));
      details.dataset.expanded = String(expanded);
      panel.inert = !expanded;
      if (reducedMotion.matches) {
        finish();
        return;
      }

      // Measure both native states, then keep the content rendered until closing finishes.
      details.open = expanded;
      const endHeight = details.getBoundingClientRect().height;
      details.open = true;
      details.style.overflow = 'hidden';
      animation = details.animate(
        { height: [`${startHeight}px`, `${endHeight}px`] },
        { duration: 300, easing: 'ease-in-out', fill: 'both' },
      );
      animation.onfinish = finish;
    });
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches && animation) finish();
    });
  });
</script>
