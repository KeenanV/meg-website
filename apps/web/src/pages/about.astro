---
import Layout from "../layouts/Layout.astro";
import { sanity, urlFor } from "../lib/sanity";
import { qAbout } from "../lib/queries";

const data = await sanity.fetch(qAbout);
---
<Layout title="About">
  <h1>About</h1>
  {data?.headshot && (
      <img
          src={urlFor(data.headshot).width(150).quality(100).url()}
          alt={data.name ?? "Headshot"}
          loading="lazy"
      />
  )}
  <h2>{data?.name}</h2>
  <div>
    {data?.bio?.map((block:any) => <p>{block.children?.map((c:any) => c.text).join('')}</p>)}
  </div>
</Layout>