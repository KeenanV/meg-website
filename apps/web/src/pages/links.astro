---
import Layout from '../layouts/Layout.astro';
import StaticGlassCard from '../components/StaticGlassCard.astro';
import GlassButton from '../components/GlassButton.astro';
import LinkIcon from '../components/LinkIcon.astro';
import SanityImage from '../components/SanityImage.astro';
import { sanity } from '../lib/sanity';
import { qLinksPage } from '../lib/queries';
import { safeHref } from '../lib/urls';
import type { About, LinksPage } from '../lib/content';

const { page, profile } = await sanity.fetch<{ page: LinksPage | null; profile: Pick<About, 'name' | 'headshot'> | null }>(qLinksPage);
const name = page?.name?.trim() || profile?.name || 'Meg Van Deusen';
const title = page?.title?.trim() || 'Clinical Psychologist · Author';
const portrait = page?.portrait?.asset ? page.portrait : profile?.headshot;
const links = (page?.links ?? []).filter(link => link.label?.trim());
---
<Layout title="Links" description={`Connect with ${name}: books, writing, news, and social media.`} navigation={false} contentWidth="2xl">
  <div class="links-page mx-auto max-w-xl">
    <StaticGlassCard class="links-pane p-5 sm:p-8">
      <header class="relative text-center">
        {portrait && <div class="mx-auto w-24 sm:w-28">
          <SanityImage image={portrait} alt={portrait.alt || name} width={336} height={504}
            sizes="(min-width: 640px) 112px, 96px" priority
            class="h-auto w-full rounded-2xl border border-white/25 shadow-xl" />
        </div>}
        <h1 class="links-name mt-5 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">{name}</h1>
        <p class="mt-2 text-sm text-white/75 sm:text-base">{title}</p>
      </header>
      <ul class="relative mt-7 space-y-3" aria-label="Meg's links">
        {links.map(link => {
          const href = safeHref(link.url);
          return <li>
            <GlassButton href={href} disabled={!href} contentClass="w-full"
              class={`min-h-16 w-full px-4 py-3 text-center ${!href ? 'text-white/65' : ''}`}>
              <span class="absolute inset-y-0 left-0 flex items-center">
                <LinkIcon name={link.icon} customImage={link.customIcon} />
              </span>
              <span class="block px-10 leading-snug [overflow-wrap:anywhere]">{link.label}</span>
              {!href && <span class="mt-1 block px-10 text-xs font-normal text-white/60">Coming soon</span>}
            </GlassButton>
          </li>;
        })}
      </ul>
    </StaticGlassCard>
  </div>
</Layout>
<style>
  .links-page :global(.links-pane) { background: linear-gradient(145deg, rgb(10 22 29 / .76), rgb(14 29 42 / .57)); }
  .links-page { container-type: inline-size; }
  .links-name { font-size: clamp(1.4rem, 6.5cqi, 2.25rem); }
</style>
