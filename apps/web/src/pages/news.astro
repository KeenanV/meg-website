---
import Layout from "../layouts/Layout.astro";
import GlassCard from "../components/GlassCard.astro";
import SectionHeader from "../components/SectionHeader.astro";

import { sanity, urlFor } from "../lib/sanity";
import { qNews } from "../lib/queries";

const news = await sanity.fetch(qNews);
---

<Layout title="News" bgImage="/bg-news.jpg" contentWidth="6xl">
  <SectionHeader
      title="News"
      subtitle="Announcements and updates."
  />

  <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {news?.map((n: any) => (
        <GlassCard href={`/news/${n.slug}`} class="p-0 overflow-hidden">
          {n.cover && (
              <img
                  src={urlFor(n.cover).width(900).height(520).fit("crop").quality(85).url()}
                  alt={n.title ?? "News cover"}
                  class="h-44 w-full object-cover"
                  loading="lazy"
              />
          )}

          <div class="p-6">
            <div class="text-lg font-semibold leading-snug">{n.title}</div>

            {n.date && (
                <div class="mt-2 text-xs text-white/50">
                  {new Date(n.date).toLocaleDateString()}
                </div>
            )}
          </div>
        </GlassCard>
    ))}
  </div>
</Layout>