---
import StaticGlassCard from './StaticGlassCard.astro';
import SanityImage from './SanityImage.astro';
import type { Article } from '../lib/content';
import { portableTextToHtml } from '../lib/portableText';
import { richTextImageUrl } from '../lib/sanity';
import { formatDate } from '../lib/dates';
interface Props { entry: Article; kind: 'blog' | 'news' }
const { entry, kind } = Astro.props;
const html = portableTextToHtml(entry.body, richTextImageUrl);
const date = kind === 'blog' ? entry.publishedAt : entry.date;
---
<StaticGlassCard class="article-pane">
  <article data-article-kind={kind}>
    <header class="p-7 md:p-10">
      <a href={'/' + kind} data-article-close class="inline-block rounded-lg text-sm text-emerald-100 underline underline-offset-4">
        <span aria-hidden="true">← </span>{kind === 'blog' ? 'All writing' : 'All news'}
      </a>
      {formatDate(date) && <p class="mt-6 text-sm text-white/80"><time datetime={date}>{formatDate(date)}</time></p>}
      <h1 class="mt-3 text-3xl font-semibold leading-tight tracking-tight md:text-4xl">{entry.title}</h1>
      {entry.excerpt && <p class="mt-5 text-lg leading-relaxed text-white/80">{entry.excerpt}</p>}
    </header>
    {entry.cover && <div class="px-7 md:px-10">
      <SanityImage image={entry.cover} alt={entry.cover.alt || ''} width={1200} priority
        class="h-auto w-full rounded-2xl border border-white/15 bg-white/95" />
    </div>}
    <div class="p-7 md:p-10">
      {html ? <div class="reading-copy" set:html={html} /> : <p class="text-white/80">More details will be available soon.</p>}
    </div>
  </article>
</StaticGlassCard>
<script>
  import '../scripts/article-return';
</script>
