---
import SideNav from './SideNav.astro';
import type { ProfileLink } from '../lib/content';
interface Props { socials?: ProfileLink[] }
const { socials = [] } = Astro.props;
---
<header class="sticky top-0 z-40 border-b border-white/15 bg-zinc-950/80 px-5 py-3 backdrop-blur-xl md:hidden">
  <div class="flex items-center justify-between gap-4">
    <button id="open-menu" type="button" hidden aria-label="Open navigation" aria-controls="mobile-menu" aria-expanded="false" aria-haspopup="dialog"
      class="mobile-menu-icon">
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
    <a href="/" class="ml-auto font-semibold tracking-tight">Meg Van Deusen</a>
  </div>
  <noscript><SideNav compact socials={socials} /></noscript>
</header>
<div id="mobile-menu" role="dialog" aria-modal="true" aria-labelledby="mobile-menu-title" hidden class="mobile-dialog text-white">
  <div class="mobile-menu-backdrop" aria-hidden="true"></div>
  <div class="mobile-menu-panel glass-surface">
    <div class="mobile-menu-content">
      <div class="flex shrink-0 items-center justify-between gap-3 border-b border-white/15 px-5 py-5">
        <div>
          <h2 id="mobile-menu-title" class="text-lg font-semibold tracking-tight"><a href="/">Meg Van Deusen</a></h2>
          <p class="mt-1 text-sm text-white/80">Clinical Psychologist</p>
        </div>
        <button id="close-menu" autofocus type="button" aria-label="Close navigation" class="mobile-menu-icon">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 5-7 7 7 7" />
          </svg>
        </button>
      </div>
      <SideNav compact showBrand={false} socials={socials} />
    </div>
  </div>
</div>
<script>
  import '../scripts/mobile-nav';
</script>
