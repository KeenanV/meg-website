---
import { getImage } from 'astro:assets';
import type { ContentImage } from '../lib/content';
import { linkIconName } from '../../../../shared/link-icons';
import SanityImage from './SanityImage.astro';
import logo from '../../../../design-assets/logos/sos.png';
import LinkedIn from '../assets/link-icons/linkedin.svg';
import Amazon from '../assets/link-icons/amazon.svg';
import Instagram from '../assets/link-icons/instagram.svg';
import Bluesky from '../assets/link-icons/bluesky.svg';
import Home from '../assets/link-icons/house.svg';
import Contact from '../assets/link-icons/envelope.svg';
import News from '../assets/link-icons/newspaper.svg';
import Book from '../assets/link-icons/book.svg';
import Website from '../assets/link-icons/globe.svg';
import Link from '../assets/link-icons/link-45deg.svg';

interface Props { name?: string; customImage?: ContentImage }
const { name, customImage } = Astro.props;
const icon = linkIconName(name);
const icons = { linkedin: LinkedIn, amazon: Amazon, instagram: Instagram, bluesky: Bluesky,
  home: Home, contact: Contact, news: News, book: Book, website: Website, link: Link };
const Icon = icon in icons ? icons[icon as keyof typeof icons] : Link;
const blogImage = icon === 'blog' ? await getImage({ src: logo, width: 368, format: 'webp', quality: 90 }) : undefined;
---
<span class="flex h-10 w-8 items-center justify-center" aria-hidden="true">
  {blogImage ? (
    <svg width="17" height="40" viewBox="0 0 1700 4000" overflow="hidden" focusable="false">
      <image href={blogImage.src} width="1700" height="4000" />
    </svg>
  ) : icon === 'custom' && customImage?.asset ? (
    <SanityImage image={customImage} alt="" width={96} sizes="28px" class="max-h-9 w-7 object-contain" />
  ) : <Icon width="26" height="26" focusable="false" />}
</span>
