---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const links = [
  { href: '/', label: 'Home' }, { href: '/about', label: 'About' },
  { href: '/books', label: 'Books' }, { href: '/blog', label: 'Blog' }, { href: '/news', label: 'News' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));
---
<aside class:list={[
  'px-4 py-8',
  compact ? 'w-full' : 'fixed inset-y-0 left-0 hidden w-52 flex-col overflow-y-auto border-r border-white/15 bg-zinc-950/35 backdrop-blur-xl md:flex',
]}>
  <a href="/" class="text-lg font-semibold tracking-tight">Meg Van Deusen</a>
  <p class="mt-1 text-sm text-white/80">Clinical Psychologist</p>
  <nav aria-label="Main" class="mt-7 flex flex-col gap-2">
    {links.map(link => (
      <a href={link.href} aria-current={active(link.href) ? 'page' : undefined} data-liquid="true"
        class:list={['group relative overflow-hidden rounded-2xl border px-4 py-3 text-base font-medium transition',
          active(link.href) ? 'border-white/20 bg-white/15 text-white' : 'border-transparent text-white/80 hover:border-white/15 hover:bg-white/10 hover:text-white']}>
        <span aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-0 transition-opacity group-hover:opacity-100"
          style="background: radial-gradient(200px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,0.12), transparent 55%);"></span>
        <span class="relative">{link.label}</span>
      </a>
    ))}
  </nav>
  {!compact && <p class="mt-auto pt-10 text-xs text-white/70">© {new Date().getFullYear()} Meg Van Deusen</p>}
</aside>
