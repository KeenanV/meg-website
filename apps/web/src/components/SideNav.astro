---
const {compact = false} = Astro.props;

const links = [
  {href: "/", label: "Home"},
  {href: "/about", label: "About"},
  {href: "/books", label: "Books"},
  {href: "/blog", label: "Blog"},
  {href: "/news", label: "News"},
];

const shell = compact
    ? "w-full"
    : "hidden md:flex md:w-52 md:flex-col md:gap-6 md:border-r md:border-white/10 md:bg-white/5 md:backdrop-blur-lg md:will-change-transform md:fixed md:left-0 md:top-0 md:h-screen";
---

<aside class={`${shell} px-3 py-8`}>
  <div class="space-y-1">
    <div class="text-lg font-semibold tracking-tight text-white">Meg Van
      Deusen
    </div>
    <div class="text-sm text-white/60">Clinical Psychologist</div>
  </div>

  <nav class="mt-6 flex flex-col gap-1">
    {links.map((l) => (
        <a
            href={l.href}
            data-liquid="true"
            class="group relative overflow-hidden rounded-2xl border border-transparent px-4 py-3 text-base font-medium text-white/80 transition
         hover:text-white hover:bg-white/10 hover:border-white/10"
        >
          <span
              class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              style="background: radial-gradient(200px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,0.12), transparent 45%);"
          ></span>

          <span class="relative">{l.label}</span>
        </a>
    ))}
  </nav>

  {!compact && (
      <div class="mt-auto text-xs text-white/50">
        © {new Date().getFullYear()} Meg Van Deusen
      </div>
  )}
</aside>