---
interface Props { title: string; subtitle?: string; href?: string; cta?: string; level?: 'h1' | 'h2' }
const { title, subtitle, href, cta = 'View all →', level: Heading = 'h2' } = Astro.props;
---
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <Heading class:list={[Heading === 'h1' ? 'page-heading' : 'text-2xl font-semibold tracking-tight']}>{title}</Heading>
    {subtitle && <p class="mt-2 text-base text-white/80">{subtitle}</p>}
  </div>
  {href && <a href={href} class="shrink-0 rounded-lg text-sm text-emerald-100 underline decoration-emerald-100/40 underline-offset-4 hover:decoration-emerald-100">{cta}</a>}
</div>
