---
const {
  href,
  class: className = "",
  hover = true,
  liquid = true,
} = Astro.props;

const base =
    "group relative overflow-hidden rounded-3xl border border-white/10 bg-black/40 backdrop-blur-lg will-change-transform";

const hoverFx = hover
    ? "transition hover:bg-gray-500/5 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-emerald-500/5"
    : "";

const pad = "p-4";

const classes = `${base} ${pad} ${hoverFx} ${className}`.trim();
---

{href ? (
<a
    href={href}
    class={classes}
    data-liquid={liquid ? "true" : "false"}
>
  <!-- cursor highlight layer -->
  <span class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
        style="background: radial-gradient(250px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,0.10), transparent 45%);">
    </span>

  <!-- sheen line -->
  <!--<span class="pointer-events-none absolute -top-24 left-0 h-48 w-full rotate-[-8deg] opacity-0 transition-opacity duration-300 group-hover:opacity-100"-->
  <!--      style="background: linear-gradient(to right, transparent, rgba(255,255,255,0.10), transparent);">-->
  <!--  </span>-->

  <div class="relative">
    <slot />
  </div>
</a>
    ) : (
<div class={classes} data-liquid={liquid ? "true" : "false"}>
    <span class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          style="background: radial-gradient(250px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,0.10), transparent 45%);">
    </span>

  <!--<span class="pointer-events-none absolute -top-24 left-0 h-48 w-full rotate-[-8deg] opacity-0 transition-opacity duration-300 group-hover:opacity-100"-->
  <!--      style="background: linear-gradient(to right, transparent, rgba(255,255,255,0.10), transparent);">-->
  <!--  </span>-->

  <div class="relative">
    <slot />
  </div>
</div>
    )}