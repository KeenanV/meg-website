---
import { getImage } from 'astro:assets';
import SideNav from '../components/SideNav.astro';
import MobileNav from '../components/MobileNav.astro';
import { sanity } from '../lib/sanity';
import { qSite } from '../lib/queries';
import type { SiteSettings } from '../lib/content';
import mountains from '../assets/backgrounds/bg.webp';
import city from '../assets/backgrounds/bg-blog.webp';
import shore from '../assets/backgrounds/bg-news.webp';
import '../styles.css';

interface Props {
  title?: string;
  description?: string;
  contentWidth?: '2xl' | '4xl' | '6xl';
  backgroundScene?: 'mountains' | 'city' | 'shore';
  noindex?: boolean;
  navigation?: boolean;
}
const { title, description, contentWidth = '4xl', backgroundScene = 'mountains', noindex = false, navigation = true } = Astro.props;
const settings = await sanity.fetch<SiteSettings | null>(qSite);
const siteTitle = settings?.title?.trim() || 'Meg Van Deusen';
const pageTitle = title ? title + ' | ' + siteTitle : siteTitle;
const pageDescription = description?.trim() || settings?.description?.trim() ||
  'Psychotherapy, books, and writing from Meg Van Deusen, clinical psychologist and author.';
const widths = { '2xl': 'max-w-2xl', '4xl': 'max-w-4xl', '6xl': 'max-w-6xl' };
const source = { mountains, city, shore }[backgroundScene];
const images = await Promise.all([768, 1280, 1920].map(width =>
  getImage({ src: source, width: Math.min(width, source.width), format: 'webp', quality: 78 })
));
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const isStaging = import.meta.env.PUBLIC_SITE_ENV === 'staging';
const isPreview = import.meta.env.EDITORIAL_PREVIEW;
---
<!doctype html>
<html lang="en" data-scene-aspect={source.width / source.height} style={`--scene-image: url("${images[2].src}")`}>
  <head>
    <meta charset="utf-8" />
    <!-- Declare the existing dark design before styles load. Firefox iOS also
         uses Dark Reader for Website Dark Mode and honors its opt-out. -->
    <meta name="color-scheme" content="dark" />
    <meta name="darkreader-lock" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#101b22" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {(noindex || isStaging || isPreview) && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-screen text-white">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-background" aria-hidden="true">
      <picture>
      <source media="(max-width: 767px), (any-pointer: coarse)" srcset={images[2].src} />
      <img src={images[2].src}
        srcset={images.map(image => image.src + ' ' + image.attributes.width + 'w').join(', ')}
        sizes="100vw" width={images[2].attributes.width} height={images[2].attributes.height}
        class="absolute inset-0 h-full w-full object-cover opacity-80" alt="" fetchpriority="high" />
      </picture>
      <div class="absolute inset-0 bg-slate-900/40"></div>
    </div>
    {navigation && <><MobileNav socials={settings?.socials ?? []} /><SideNav socials={settings?.socials ?? []} /></>}
    <main id="main-content" tabindex="-1" class:list={['min-h-screen px-5 py-8 md:px-10 md:py-12', { 'md:ml-52': navigation }]}>
      {isPreview && <aside data-editorial-preview class="mx-auto mb-5 max-w-6xl rounded-xl border border-amber-200/30 bg-slate-950/80 px-4 py-2 text-sm text-amber-100">Private draft preview · Changes here are not published. <a href="/api/preview/disable" class="underline">Exit preview</a></aside>}
      {isStaging && <p class="mx-auto mb-5 max-w-6xl rounded-xl border border-amber-200/30 bg-slate-950/80 px-4 py-2 text-sm text-amber-100">Staging · Private test environment</p>}
      <div class:list={['mx-auto', widths[contentWidth]]}><slot /></div>
    </main>
    <script>
      if (import.meta.env.EDITORIAL_PREVIEW) {
        import('@sanity/visual-editing').then(({enableVisualEditing}) => enableVisualEditing({
          history: {
            subscribe: (navigate) => {
              const report = () => navigate({type: 'replace', url: location.pathname + location.search});
              report();
              window.addEventListener('popstate', report);
              return () => window.removeEventListener('popstate', report);
            },
            update: (update) => {
              if (update.type === 'pop') { window.history.back(); return; }
              const next = new URL(update.url, location.origin);
              if (next.origin !== location.origin || next.pathname.startsWith('/api/')) return;
              if (next.href === location.href) return;
              if (update.type === 'replace') location.replace(next.href);
              else location.assign(next.href);
            },
          },
          refresh: () => { window.location.reload(); return Promise.resolve(); },
        }));
      }
      import '../scripts/mobile-scene';
      import '../scripts/input-method';
      import { bindLiquidInteraction } from '../scripts/liquid-interaction';
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      document.querySelectorAll<HTMLElement>('[data-liquid="true"]').forEach((element) => {
        bindLiquidInteraction(element, reducedMotion);
      });
    </script>
  </body>
</html>
