---
import { getImage } from 'astro:assets';
import SideNav from '../components/SideNav.astro';
import MobileNav from '../components/MobileNav.astro';
import { sanity } from '../lib/sanity';
import { qSite } from '../lib/queries';
import type { SiteSettings } from '../lib/content';
import mountains from '../assets/backgrounds/bg.webp';
import city from '../assets/backgrounds/bg-blog.webp';
import shore from '../assets/backgrounds/bg-news.webp';
import '../styles.css';

interface Props {
  title?: string;
  description?: string;
  contentWidth?: '2xl' | '4xl' | '6xl';
  backgroundScene?: 'mountains' | 'city' | 'shore';
  noindex?: boolean;
}
const { title, description, contentWidth = '4xl', backgroundScene = 'mountains', noindex = false } = Astro.props;
const settings = await sanity.fetch<SiteSettings | null>(qSite);
const siteTitle = settings?.title?.trim() || 'Meg Van Deusen';
const pageTitle = title ? title + ' | ' + siteTitle : siteTitle;
const pageDescription = description?.trim() || settings?.description?.trim() ||
  'Psychotherapy, books, and writing from Meg Van Deusen, clinical psychologist and author.';
const widths = { '2xl': 'max-w-2xl', '4xl': 'max-w-4xl', '6xl': 'max-w-6xl' };
const source = { mountains, city, shore }[backgroundScene];
const images = await Promise.all([768, 1280, 1920].map(width =>
  getImage({ src: source, width: Math.min(width, source.width), format: 'webp', quality: 78 })
));
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#101b22" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-white">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <img src={images[2].src}
        srcset={images.map(image => image.src + ' ' + image.attributes.width + 'w').join(', ')}
        sizes="100vw" width={images[2].attributes.width} height={images[2].attributes.height}
        class="absolute inset-0 h-full w-full object-cover opacity-80" alt="" fetchpriority="high" />
      <div class="absolute inset-0 bg-slate-900/40"></div>
    </div>
    <MobileNav />
    <SideNav />
    <main id="main-content" tabindex="-1" class="min-h-screen px-5 py-8 md:ml-52 md:px-10 md:py-12">
      <div class:list={['mx-auto', widths[contentWidth]]}><slot /></div>
    </main>
    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      document.querySelectorAll<HTMLElement>('[data-liquid="true"]').forEach((element) => {
        let frame: number | undefined;
        element.addEventListener('pointermove', (event) => {
          if (reducedMotion.matches || event.pointerType === 'touch') return;
          if (frame !== undefined) cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const rect = element.getBoundingClientRect();
            element.style.setProperty('--mx', ((event.clientX - rect.left) / rect.width) * 100 + '%');
            element.style.setProperty('--my', ((event.clientY - rect.top) / rect.height) * 100 + '%');
            frame = undefined;
          });
        });
        element.addEventListener('pointerleave', () => {
          if (frame !== undefined) cancelAnimationFrame(frame);
          frame = undefined;
          // Keep the last position while opacity fades; resetting it causes a center flash.
        });
      });
    </script>
  </body>
</html>
